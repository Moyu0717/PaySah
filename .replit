# Candidate configuration; actual Replit deployment acceptance remains required.
entrypoint = "src/apps/api/src/server.ts"
run = ["sh", "-c", "cd src && npm run start:deployment"]
modules = ["nodejs-24"]

[env]
HOST = "0.0.0.0"
PORT = "3000"
DEMO_MODE = "true"

[deployment]
build = ["sh", "-c", "cd src && npm ci && npm run build"]
run = ["sh", "-c", "cd src && node dist/apps/api/src/deployment.js"]

[[ports]]
localPort = 3000
externalPort = 80
